{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call only AEGIS VAULT's own commands and listen for lock events.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-vault-status",
    "allow-create-vault",
    "allow-unlock",
    "allow-unlock-with-recovery-key",
    "allow-lock",
    "allow-touch",
    "allow-vault-overview",
    "allow-get-item",
    "allow-get-item-for-edit",
    "allow-reveal-field",
    "allow-item-history",
    "allow-copy-field",
    "allow-copy-generated",
    "allow-create-item",
    "allow-update-item",
    "allow-delete-item",
    "allow-set-favorite",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-set-settings",
    "allow-generate-password",
    "allow-generate-passphrase",
    "allow-estimate-strength",
    "allow-change-password",
    "allow-set-password-after-recovery",
    "allow-regenerate-recovery-key",
    "allow-rotate-vault-key",
    "allow-export-backup",
    "allow-import-file"
  ]
}
